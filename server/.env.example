# =============================================================================
# Midori — Environment Variables  (.env.example)
# Copy to .env and fill in your values:   cp .env.example .env
# =============================================================================

# ── Django ────────────────────────────────────────────────────────────────────
SECRET_KEY=your-secret-key-here-min-50-chars
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,10.0.2.2

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DB_NAME=plant_disease
DB_USER=postgres
DB_PASSWORD=2004
DB_HOST=localhost
DB_PORT=5432

# ── CORS — allow Flutter app (dev) ───────────────────────────────────────────
# Add your device/emulator IP if testing on a real phone
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://10.0.2.2:8000

# ── ML model directory ────────────────────────────────────────────────────────
# Defaults to server/ml_models/ — only set if you want a custom path
# ML_MODELS_DIR=/absolute/path/to/ml_models

# ── Media root ────────────────────────────────────────────────────────────────
# Where uploaded images and Grad-CAM PNGs are saved
# MEDIA_ROOT=/absolute/path/to/media
