# =============================================================================
# Midori — Root .gitignore
# =============================================================================

# ── Python / Django ───────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/

# Django
*.log
local_settings.py
server/media/
server/static/
db.sqlite3

# Environment files (contain secrets — NEVER commit)
server/.env
.env

# Debug / test scripts (dev-only, not part of the project)
server/test_*.py
server/test_output.txt

# ── Machine Learning ──────────────────────────────────────────────────────────
# Extracted model files (large — regenerate with  python scripts/setup_models.py)
server/ml/models/
# Uncomment the line below to also ignore model zips (if using cloud storage):
# server/ml/weights/

# ── Flutter / Dart ────────────────────────────────────────────────────────────
mobile/.dart_tool/
mobile/.packages
mobile/build/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/pubspec.lock

# ── OS artifacts ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo

# ── IDE ───────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.iml

# ── Jupyter ───────────────────────────────────────────────────────────────────
docs/notebooks/.ipynb_checkpoints/
